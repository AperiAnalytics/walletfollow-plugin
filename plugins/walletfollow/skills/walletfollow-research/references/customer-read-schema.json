    {
      "tool": "wf_get_copy_portfolios",
      "method": "GET",
      "path": "/v1/copy/portfolios",
      "oauth_scope": "data:read",
      "marketplace_available": true,
      "description": "Public copy portfolios. Read only. Returns original availability, coverage, timestamps and gaps. Capability reports describe current support.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "properties": {
              "cursor": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[A-Za-z0-9_-]{1,400}$"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 48
              },
              "q": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "sort": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "ret_dd_30d"
                  },
                  {
                    "type": "string",
                    "const": "roi_30d"
                  },
                  {
                    "type": "string",
                    "const": "roi_7d"
                  },
                  {
                    "type": "string",
                    "const": "max_dd"
                  },
                  {
                    "type": "string",
                    "const": "sharpe_30d"
                  },
                  {
                    "type": "string",
                    "const": "watchers"
                  },
                  {
                    "type": "string",
                    "const": "newest"
                  },
                  {
                    "type": "string",
                    "const": "roi_since_start"
                  },
                  {
                    "type": "string",
                    "const": "risk"
                  }
                ]
              },
              "period": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "7d"
                  },
                  {
                    "type": "string",
                    "const": "30d"
                  },
                  {
                    "type": "string",
                    "const": "90d"
                  },
                  {
                    "type": "string",
                    "const": "all"
                  }
                ]
              },
              "tab": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "all"
                  },
                  {
                    "type": "string",
                    "const": "watched"
                  }
                ]
              },
              "leader": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^0x[0-9a-f]{40}$"
              },
              "coin": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[@A-Za-z0-9][A-Za-z0-9@:._/-]{0,39}$"
              },
              "risk": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "lt3"
                  },
                  {
                    "type": "string",
                    "const": "3to5"
                  },
                  {
                    "type": "string",
                    "const": "gte5"
                  },
                  {
                    "type": "string",
                    "const": "low"
                  },
                  {
                    "type": "string",
                    "const": "medium"
                  },
                  {
                    "type": "string",
                    "const": "high"
                  }
                ]
              },
              "leaders_min": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "leaders_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "fee": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "none"
                  },
                  {
                    "type": "string",
                    "const": "le10"
                  },
                  {
                    "type": "string",
                    "const": "any"
                  }
                ]
              },
              "tracked_days_min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3650
              },
              "style": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "swing"
                  },
                  {
                    "type": "string",
                    "const": "majors"
                  },
                  {
                    "type": "string",
                    "const": "hip3"
                  },
                  {
                    "type": "string",
                    "const": "low_leverage"
                  }
                ]
              },
              "listing": {
                "type": "string",
                "const": "ranked"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
